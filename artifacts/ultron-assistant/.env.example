# Supabase browser configuration (URL and publishable/anon key are public).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The same Supabase project values for server-side session verification.
# Never use a service-role key in the browser or for ordinary chat requests.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Use the Gemini API key only on the server, as a Replit Secret or Vercel
# environment variable. The current Replit secret may still be named
# OPENAI_API_KEY; the API server accepts that name only as a Gemini-key alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For a Vercel-hosted frontend, set this to the separately hosted API origin
# including its /api path, for example https://your-api.example/api.
VITE_API_BASE_URL=
